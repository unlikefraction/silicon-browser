{
  "name": "silicon-browser-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 tsc --noEmit && NEXT_TELEMETRY_DISABLED=1 next build --webpack && node publish-docs.mjs && node scripts/check-export.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1 --port 8092",
    "preview": "node dev.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "sync-ui": "node scripts/sync-silicon-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "lucide-react": "1.48.0",
    "motion": "14.0.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.0"
}
