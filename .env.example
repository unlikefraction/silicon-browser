# Exact frontend origin: CORS and hosted Accounts callback.
SB_ORIGIN=https://browser.teamofsilicons.com
# CLI-only API target.
SB_BACKEND_URL=https://backend.browser.teamofsilicons.com

# Backend
PORT=8080
SB_DATABASE_URL=sqlite://silicon-browser-accounts.db?mode=rwc
RUST_LOG=silicon_browser_backend=info,tower_http=info
# Stable encryption key. Generate with: openssl rand -hex 32
SB_ENCRYPTION_KEY=

# Silicon Accounts application credentials (backend only).
ACCOUNTS_URL=https://accounts.teamofsilicons.com
ACCOUNTS_APP_ID=browser
ACCOUNTS_APP_SECRET=
# Configure the Accounts webhook at /webhooks/accounts.
ACCOUNTS_WEBHOOK_SECRET=

# Remote browser and search providers (backend only).
BROWSER_USE_API_KEY=
TINYFISH_API_KEYS=

# CLI-only optional overrides.
# SB_AUTHTOKEN accepts an Accounts JWT for this invocation, or an slt_ token for setup.
# SB_AUTHTOKEN=
# SB_HOME=/tmp/silicon-browser-cli-state
# SILICON_HOME=/path/to/silicon-home
# SB_CONTROLLER_BIN=/absolute/path/to/sb-browser-engine
