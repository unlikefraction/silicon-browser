# Exact frontend origin on Vercel: used for CORS and live-session links.
SB_ORIGIN=https://browser.teamofsilicons.com
# CLI API target (the backend does not use this to host frontend assets).
SB_BACKEND_URL=https://backend.browser.teamofsilicons.com

# Server
PORT=8080
SB_DATABASE_URL=sqlite://silicon-browser.db?mode=rwc
RUST_LOG=silicon_browser_backend=info,tower_http=info
# Generate with: openssl rand -hex 32
SB_ENCRYPTION_KEY=

# Silicon IAM application (server only)
SILICON_IAM_URL=https://backend.iam.teamofsilicons.com
IAM_APP_ID=tos>browser
IAM_APP_SECRET=
# Must match the secret/version configured on IAM for /webhooks/iam.
# The webhook route is disabled when no secret is set; auth cache expires after 15s.
IAM_WEBHOOK_SECRET=
IAM_WEBHOOK_KEY_VERSION=1
# Isolated IAM testing only: use its root key, never the environment UUID.
# Leave UNSET in production; an explicitly empty or malformed key is rejected.
# IAM_TEST_ENVIRONMENT_KEY=<test-environment-root-key>

# Providers (server only; comma-separate TinyFish keys to enable pooling)
BROWSER_USE_API_KEY=
TINYFISH_API_KEYS=

# Optional Space Station telemetry. Keep table keys server-side; the frontend
# sends through a same-origin endpoint and must never receive these values.
# Telemetry is enabled by default when a key is configured; set
# SPACE_STATION_TELEMETRY=0 to opt out. The four tables are owned by tos.
SPACE_STATION_URL=https://backend.spacestation.teamofsilicons.com
SPACE_STATION_ORG=tos
SPACE_STATION_TELEMETRY=1
SPACE_STATION_BROWSER_BACKEND_KEY=
SPACE_STATION_BROWSER_CLI_KEY=
SPACE_STATION_FRONTEND_ANALYTICS_KEY=
SPACE_STATION_FRONTEND_EVENTS_KEY=

# Automatic delivery of native recordings and Silicon command logs.
# Both values are required together. Unconfigured servers refuse new browser sessions.
BRIEFCASE_URL=
BRIEFCASE_APP_ID=
# Configured staging/upload cap (default 512 MiB); incoming OBO transfer must
# still finish within the proof lifetime. This does not certify arbitrary sizes.
SB_RECORDING_MAX_BYTES=536870912
# Test only: imported Briefcase IAM app secret (ask_ + 43 base64url characters)
# from the same world as IAM_TEST_ENVIRONMENT_KEY. This is not an IAM root key.
# BRIEFCASE_TEST_ENVIRONMENT_KEY=

# CLI-only overrides (do not put these in the backend deployment environment).
# SB_AUTHTOKEN accepts an IAM-issued one-shot oac_ token during `sb setup --org ...`,
# or an org-bound short-lived oat_ access token as an invocation-only bearer override.
# SB_AUTHTOKEN=
# Separate fresh Browser SLT for backend-owned recording authorization in setup.
# SB_RECORDING_SLT=
# SB_ORG_ID=
# SB_HOME=/tmp/silicon-browser-cli-state
# Optional local native controller override; never used by the AWS backend.
# SB_CONTROLLER_BIN=/absolute/path/to/agent-browser
