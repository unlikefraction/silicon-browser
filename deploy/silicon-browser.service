[Unit]
Description=Silicon Browser metadata API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=silicon-browser
Group=silicon-browser
WorkingDirectory=/var/lib/silicon-browser
EnvironmentFile=/etc/silicon-browser/runtime.env
ExecStart=/opt/silicon-browser/current/silicon-browser-backend
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/silicon-browser
LimitNOFILE=65536
TasksMax=1024
MemoryMax=3G

[Install]
WantedBy=multi-user.target
