[Unit]
Description=Back up Silicon Browser metadata
After=silicon-browser.service

[Service]
Type=oneshot
User=silicon-browser
Group=silicon-browser
ExecStart=/usr/bin/python3 /opt/silicon-browser/current/backup.py
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/silicon-browser
